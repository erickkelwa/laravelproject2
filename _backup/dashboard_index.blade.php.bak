                @else
                    @php $maxTotal = $courseBreakdown->max('total'); @endphp
                    @foreach($courseBreakdown as $item)
                    @php
                        $percentage = $maxTotal > 0 ? round(($item->total / $totalStudents) * 100) : 0;
                        $colors = ['primary','success','info','warning','danger','secondary'];
                        $color = $colors[$loop->index % count($colors)];
                    @endphp
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="fw-semibold text-truncate me-2" style="max-width:200px;" title="{{ $item->course }}">
                                {{ $item->course }}
                            </span>
                            <span class="text-muted fw-bold">
                                {{ $item->total }} <small>({{ $percentage }}%)</small>
                            </span>
                        </div>
                        <div class="progress" style="height: 8px; border-radius: 4px;">
                            <div class="progress-bar bg-{{ $color }}"
                                 role="progressbar"
                                 style="width: {{ $percentage }}%"
                                 aria-valuenow="{{ $percentage }}"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>
                        </div>
                    </div>
                    @endforeach

